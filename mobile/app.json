{
  "expo": {
    "name": "Zorlii",
    "slug": "zorlii",
    "scheme": "zorlii",
    "version": "1.0.0",
    "icon": "./assets/zorlii-logo.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Zorlii to choose a profile photo and attach photos or videos to posts."
        }
      ],
      "expo-notifications",
      "expo-video"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zorlii.app"
    },
    "android": {
      "package": "com.zorlii.app",
      "usesCleartextTraffic": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    }
  }
}
