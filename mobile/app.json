{
  "expo": {
    "name": "Zorlii",
    "slug": "zorlii",
    "scheme": "zorlii",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Zorlii to choose a profile photo."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zorlii.app"
    },
    "android": {
      "package": "com.zorlii.app",
      "usesCleartextTraffic": true
    }
  }
}
