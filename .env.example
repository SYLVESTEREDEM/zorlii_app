# Copy to .env and replace placeholders privately; never share or commit your credentials.
ZORLII_DB_PATH=
ZORLII_COOKIE_SECURE=0
# Resend works on Railway Free, Trial, and Hobby plans (HTTPS API).
ZORLII_EMAIL_PROVIDER=resend
ZORLII_RESEND_API_KEY=replace-with-resend-api-key
ZORLII_EMAIL_FROM=Zorlii <no-reply@auth.your-domain.example>
# SMTP is also supported on platforms/plans that allow outbound SMTP.
ZORLII_SMTP_HOST=smtp.your-provider.example
ZORLII_SMTP_PORT=587
ZORLII_SMTP_USER=your-smtp-user
ZORLII_SMTP_PASSWORD=replace-with-provider-secret
ZORLII_SMTP_FROM=Zorlii <no-reply@your-domain.example>
ZORLII_SMTP_STARTTLS=1
ZORLII_OTP_SECRET=generate-a-private-random-secret-at-least-32-characters
